SLUICE_IMAGE=sluice/worker:0.1.0

# Required database credentials. Leaving these blank makes docker compose fail;
# that is the intended safety guard.
POSTGRES_USER=
# Required database password. It is inserted directly into a connection URL, so
# use URL-safe characters only. Recommended: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=prefect

# Required Prefect API Basic Auth string. Leaving it blank makes docker compose
# fail; set a URL-safe user:password value and keep server/client values in sync.
PREFECT_API_AUTH_STRING=
